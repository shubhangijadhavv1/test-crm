  "private": true,
  "description": "GDC CRM core REST API (MERN, TypeScript) — per GDC-CRM-Blueprint.md",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "reset": "tsx src/seed/reset.ts",
    "audit:integration": "tsx src/audit/integration.ts",
    "test:branch": "tsx src/audit/branch-policy.test.ts",
    "test:qa": "tsx src/audit/qa-flow.test.ts",
    "test:checklist": "tsx src/audit/checklist.test.ts",
    "test:concurrency": "tsx src/audit/concurrency.test.ts",
    "test:taskfilters": "tsx src/audit/task-filters.test.ts",
    "test:taskauthz": "tsx src/audit/task-authz.test.ts",
    "test:taskoverdue": "tsx src/audit/task-overdue.test.ts",
    "test:taskcrud": "tsx src/audit/task-crud.test.ts",
    "test:agentengine": "tsx src/audit/agent-engine.test.ts",
    "test:agentapi": "tsx src/audit/agent-api.test.ts",
    "test:agentfinalize": "tsx src/audit/agent-finalize.test.ts",
    "test:agentscreenshot": "tsx src/audit/agent-screenshot.test.ts",
    "test:agentlivestate": "tsx src/audit/agent-livestate.test.ts",
    "test:agentbreaks": "tsx src/audit/agent-breaks.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@types/multer": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "socket.io": "^4.8.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.4",
    "@types/web-push": "^3.6.4",
    "mongodb-memory-server": "^10.1.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
