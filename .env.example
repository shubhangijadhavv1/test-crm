# Copy to .env and adjust. All values have safe dev defaults.

# If unset, an in-memory MongoDB is started automatically (mongodb-memory-server).
# For a real DB use e.g. mongodb://127.0.0.1:27017/gdc-crm  or an Atlas SRV URI.
MONGODB_URI=

PORT=4000
NODE_ENV=development

# CORS origin of the React app + Socket.IO. In production set to the web app's exact origin,
# e.g. https://crm.yourcompany.com  (single-origin) or https://app.yourcompany.com (split).
CLIENT_ORIGIN=http://localhost:5173

# --- Production deployment ---
# Single-origin mode: this server also serves the built React app (client/dist). One domain
# for web + API + sockets + screenshots → no CORS, cookies "just work", agent points at one URL.
SERVE_CLIENT=false
# Optional override for the built client folder (defaults to ../client/dist).
# CLIENT_DIST=/var/www/gdc/client/dist

# Refresh-cookie policy. Leave as 'lax' for single-origin (web + API on the SAME domain).
# Use 'none' ONLY if the web app and API are on DIFFERENT sites (requires HTTPS on both).
COOKIE_SAMESITE=lax
# Force the Secure flag. Defaults to true in production / when COOKIE_SAMESITE=none.
# COOKIE_SECURE=true

# Auth secrets — CHANGE in production
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# First Super Admin (seed)
SEED_SUPERADMIN_EMAIL=aarav@gdc.com
SEED_SUPERADMIN_PASSWORD=Admin@12345

# Whoxy WHOIS API key (https://www.whoxy.com/) — enables live WHOIS/expiry/ownership lookups
WHOXY_API_KEY=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
